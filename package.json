{
  "name": "studymate-agent",
  "version": "0.1.0",
  "description": "AI-powered personal exam preparation agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "studymate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node dist/cli.js --help",
    "demo": "node scripts/seed-demo.mjs",
    "serve": "npm run build && node dist/server/index.js",
    "web": "cd web && npm run dev"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
